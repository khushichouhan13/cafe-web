# Root .gitignore for Brew Haven Café monorepo

# Dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
**/.env
**/.env.local
**/.env.production

# Build output
client/dist/
client/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel/
